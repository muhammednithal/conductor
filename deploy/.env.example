# Copy this file to .env and fill in values for local development.
# Never commit .env to git.

# Orchestrator
DATABASE_URL=postgres://conductor:conductor@localhost:5432/conductor
REDIS_ADDR=localhost:6379
GRPC_ADDR=:9000
MIGRATIONS_DIR=migrations

# Worker
ORCHESTRATOR_ADDR=:9000

# Integration tests
TEST_DATABASE_URL=postgres://conductor:conductor@localhost:5432/conductor
TEST_REDIS_URL=localhost:6379
